+def smooth_switch(r: torch.Tensor, onset: float, cutoff: float) -> torch.Tensor:
+    """C2 switch of r: 1 below onset, 0 at cutoff and beyond."""
+    t = ((r - onset) / (cutoff - onset)).clamp(0.0, 1.0)
+    return 1.0 - t * t * t * (10.0 + t * (-15.0 + 6.0 * t))
